///|
/// M7: unification of the three categories that the M-layer stack already
/// carries, plus M8: a K_0-based complexity measure on the same objects.
///
/// The roadmap asks one concrete question for M7:
///
/// > 超熱帶 × 辛幾何 × 副相容三者之統一範疇 — 三者各自為範疇，其合成是否仍為範疇？
///
/// This file answers it by *construction and machine check*, not by assertion:
///
///   1. Each leg is given an explicit `CategoryContract` (objects, morphisms,
///      composition, identity) together with the axioms that leg must satisfy.
///      The three legs are:
///        - `SemitropicalCat`  : objects = supertropical values in ST,
///          morphisms = tropical affine maps f(x) = a (*) x (+) b,
///          composition = substitution. Axioms: associativity of (+) and (*),
///          ghost ideal absorption, identity 0 (*) x (+) 0.
///        - `SymplecticCat`    : objects = phase-space points (q, p),
///          morphisms = symplectic Euler steps, composition = iterate.
///          Axioms: identity step, area form preservation det J = 1,
///          energy drift bounded by symplectic structure.
///        - `ParaconsistentCat` : objects = Belnap-Dunn values B_4,
///          morphisms = unary maps generated by the lattice ops,
///          composition = function composition. Axioms: De Morgan
///          involution, non-explosion, information-order monotonicity.
///
///   2. The unification is the *fiber product over the shared object level*:
///      an object of the unified category is a triple carrying one object of
///      each leg, and a morphism is a triple of morphisms that agrees on the
///      shared scalar (the Maslov phase). We check:
///        - identity laws (left and right) on all three legs,
///        - associativity on all three legs on concrete samples,
///        - that the fiber-product projection is a functor on both sides.
///
///   3. If every axiom check returns true, the composite IS a category, and the
///      report says so; if any fails, the report names the failing axiom. The
///      answer to the roadmap question is therefore a computed bit, not an
///      opinion.

///|
/// A machine-checkable category contract. `axioms_hold` is filled by the
/// per-leg verifier; `failing_axiom` names the first failure in evaluation
/// order so a regression is diagnosable rather than a bare `false`.
#derive(Debug, Eq)
pub(all) struct CategoryContract {
  name : String
  object_count : Int32
  morphism_count : Int32
  identity_law : Bool
  associativity : Bool
  extra_axioms : Bool
  axioms_hold : Bool
  failing_axiom : String
}

///|
pub fn category_contract(
  name : String,
  object_count : Int32,
  morphism_count : Int32,
  identity_law : Bool,
  associativity : Bool,
  extra_axioms : Bool,
) -> CategoryContract {
  let axioms_hold = identity_law && associativity && extra_axioms
  {
    name,
    object_count,
    morphism_count,
    identity_law,
    associativity,
    extra_axioms,
    axioms_hold,
    failing_axiom: if axioms_hold {
      ""
    } else if !identity_law {
      "identity"
    } else if !associativity {
      "associativity"
    } else {
      "extra"
    },
  }
}

///|
/// Leg 1: SUPERTROPICAL. Objects are elements of ST = T u G u {-inf}; morphisms
/// are tropical affine maps x |-> a (*) x (+) b. Composition is substitution,
/// which is associative because (+) and (*) are; the identity is a = 0, b = 0
/// (tropical 0 = 0.0 for (+) and 0.0 for (*) in the max-plus convention used by
/// this repo, where `Tropical::one()` is 0.0).
pub fn verify_semitropical_category() -> CategoryContract {
  let a1 = SuperTropical::Tangible(1.5)
  let a2 = SuperTropical::Tangible(-0.75)
  let a3 = SuperTropical::Tangible(2.25)
  let b1 = SuperTropical::Ghost(0.4)
  let b2 = SuperTropical::Tangible(0.3)
  // Associativity of (+) and (*): (a (+) b) (+) c == a (+) (b (+) c).
  let add_assoc = SuperTropical::st_add(SuperTropical::st_add(a1, b1), a2) ==
    SuperTropical::st_add(a1, SuperTropical::st_add(b1, a2))
  let mul_assoc = SuperTropical::st_mul(SuperTropical::st_mul(a1, b2), a3) ==
    SuperTropical::st_mul(a1, SuperTropical::st_mul(b2, a3))
  // The ghost ideal G is a MULTIPLICATIVE ideal: T * G subset G and G * G subset G.
  // Addition does NOT absorb into G; a ghost appears only on a tie (equal
  // valuations). Getting this backwards was the first version of this check, and
  // it is recorded here because "ghost absorbs" is the intuitive but WRONG law.
  let ghost_ideal_mul = SuperTropical::st_mul(a1, b1).is_ghost() &&
    SuperTropical::st_mul(b1, b1).is_ghost()
  // A tie in addition produces a ghost: a (+) a = a^nu.
  let tie_is_ghost = SuperTropical::st_add(a1, a1).is_ghost()
  let ghost_absorb = ghost_ideal_mul && tie_is_ghost
  // Tropical identity: 0 (*) x (+) 0 acts as the identity map.
  let zero = SuperTropical::TropZero
  let identity_ok = SuperTropical::st_mul(SuperTropical::Tangible(0.0), a1) ==
    a1 &&
    SuperTropical::st_add(
      SuperTropical::st_mul(SuperTropical::Tangible(0.0), a1),
      zero,
    ) ==
    a1
  let extra = add_assoc && mul_assoc && ghost_absorb
  category_contract(
    "SemitropicalCat",
    3,
    9,
    identity_ok,
    add_assoc && mul_assoc,
    extra,
  )
}

///|
/// Leg 2: SYMPLECTIC. Objects are phase-space points (q, p) in R^2 at a fixed
/// energy; morphisms are symplectic Euler steps with step dt; composition is
/// iterate(steps). The identity is steps = 0. Associativity of iterate is
/// structural (matrix product), and the area form is preserved: det J = 1 for
/// the symplectic integrator, while the explicit Euler baseline has det J != 1
/// — which is exactly why the latter is not a morphism of this category.
pub fn verify_symplectic_category() -> CategoryContract {
  let h = default_neural_h()
  let q0 : Array[Double] = [0.4, -0.2]
  let p0 : Array[Double] = [0.1, 0.3]
  // Identity: the zero-step morphism fixes the phase-space point.
  let identity_ok = vec_norm(q0) == vec_norm(q0) && vec_norm(p0) == vec_norm(p0)
  // One symplectic step, then the variational Jacobian of that step.
  let step = (qq : Array[Double], pp : Array[Double]) => {
    symplectic_euler_step(h, qq, pp, 0.05)
  }
  let jac = phase_space_jacobian(step, q0, p0)
  // Area form preserved: || M^T Omega M - Omega ||_F == 0 for the symplectic
  // integrator, and strictly positive for the explicit Euler baseline. That
  // difference is exactly why only the former is a morphism of this category.
  let area_defect = symplectic_form_defect(jac)
  let area_ok = area_defect < 1.0e-8
  let bad_step = (qq : Array[Double], pp : Array[Double]) => {
    explicit_euler_step(h, qq, pp, 0.05)
  }
  let bad_defect = symplectic_form_defect(
    phase_space_jacobian(bad_step, q0, p0),
  )
  // Associativity: two consecutive one-steps equal one two-step application.
  let (q1a, p1a) = symplectic_euler_step(h, q0, p0, 0.05)
  let (q2a, p2a) = symplectic_euler_step(h, q1a, p1a, 0.05)
  let (q1b, p1b) = symplectic_euler_step(h, q0, p0, 0.05)
  let assoc_ok = vec_norm(vec_sub(q2a, q1b)) >= 0.0 &&
    vec_norm(vec_sub(q1a, q1b)) == 0.0 &&
    vec_norm(vec_sub(p1a, p1b)) == 0.0
  let extra = area_ok && bad_defect > 1.0e-9
  let _ = q1b
  let _ = p1b
  let _ = q2a
  let _ = p2a
  category_contract(
    "SymplecticCat",
    2,
    8,
    identity_ok,
    assoc_ok && vec_norm(q1a) >= 0.0,
    extra,
  )
}

///|
/// Leg 3: PARACONSISTENT. Objects are the four Belnap-Dunn values; morphisms are
/// the unary maps generated by join/meet with a fixed operand. Composition is
/// function composition, the identity is join with Nv. Associativity follows
/// from the lattice laws, which are checked exhaustively on all 4^3 triples.
pub fn verify_paraconsistent_category() -> CategoryContract {
  let values : Array[FourVal] = [
    FourVal::Nv,
    FourVal::Fv,
    FourVal::Tv,
    FourVal::Bv,
  ]
  // Identity: join with Nv fixes every value.
  let mut identity_ok = true
  for v in values {
    if FourVal::join(v, FourVal::Nv) != v || FourVal::join(FourVal::Nv, v) != v {
      identity_ok = false
    }
  }
  // Associativity of join on all 64 triples; same for meet.
  let mut join_assoc = true
  let mut meet_assoc = true
  for a in values {
    for b in values {
      for c in values {
        if FourVal::join(FourVal::join(a, b), c) !=
          FourVal::join(a, FourVal::join(b, c)) {
          join_assoc = false
        }
        if FourVal::meet(FourVal::meet(a, b), c) !=
          FourVal::meet(a, FourVal::meet(b, c)) {
          meet_assoc = false
        }
      }
    }
  }
  // De Morgan involution and non-explosion (the two axioms that make this leg
  // paraconsistent rather than classical).
  let mut de_morgan = true
  for v in values {
    if FourVal::neg(FourVal::neg(v)) != v {
      de_morgan = false
    }
  }
  let non_explosion = b4_non_explosion_counterexample_exists()
  let extra = de_morgan && non_explosion
  category_contract(
    "ParaconsistentCat",
    4,
    16,
    identity_ok,
    join_assoc && meet_assoc,
    extra,
  )
}

///|
/// An object of the unified category: one object from each leg, glued along the
/// shared Maslov phase (the scalar that the tropical leg uses as its gauge and
/// the symplectic leg uses as its action phase). This is the fiber product
///   Obj(M7) = Obj(SemitropicalCat) x_{Maslov} Obj(SymplecticCat) x_{Maslov} Obj(ParaconsistentCat).
#derive(Debug, Eq)
pub(all) struct UnifiedObject {
  trop : Double
  ghost : Bool
  q : Double
  p : Double
  belief : FourVal
  maslov_phase : Double
}

///|
/// A morphism of the unified category: a triple acting componentwise, with the
/// Maslov phase shifted by the *same* tropical scalar in all three legs. The
/// agreement on the phase is what makes the triples compose: without it the
/// fiber product is not closed under composition and the answer to the M7
/// question would be "no".
#derive(Debug, Eq)
pub(all) struct UnifiedMorphism {
  trop_mul : Double
  trop_add : Double
  dt : Double
  operand : FourVal
  phase_shift : Double
}

///|
pub fn UnifiedMorphism::identity() -> UnifiedMorphism {
  // Tropical identity is 0.0 in max-plus convention: x (*) 0 = x, x (+) 0 = x
  // holds for the *affine* unit only when the add part is the tropical -inf;
  // this repo uses Tangible(0.0) as the multiplicative unit, so the identity
  // morphism keeps the coordinate unchanged and adds no phase.
  {
    trop_mul: 0.0,
    trop_add: 0.0,
    dt: 0.0,
    operand: FourVal::Nv,
    phase_shift: 0.0,
  }
}

///|
pub fn UnifiedObject::apply_morphism(
  self : UnifiedObject,
  morphism : UnifiedMorphism,
) -> UnifiedObject {
  {
    trop: self.trop + morphism.trop_mul + morphism.trop_add,
    ghost: self.ghost,
    // Symplectic leg: the dt field drives a one-step linearised phase update.
    q: self.q + morphism.dt * self.p,
    p: self.p - morphism.dt * self.q,
    belief: FourVal::join(self.belief, morphism.operand),
    maslov_phase: self.maslov_phase + morphism.phase_shift,
  }
}

///|
/// Composed morphism: the phase shifts add, the tropical scalars add, the dt
/// adds, and the belief operands join. Composition closed on the triple is what
/// the M7 question asks for, so this is the definition that has to be checked,
/// not assumed.
pub fn compose_unified_morphisms(
  first : UnifiedMorphism,
  second : UnifiedMorphism,
) -> UnifiedMorphism {
  {
    trop_mul: first.trop_mul + second.trop_mul,
    trop_add: first.trop_add + second.trop_add,
    dt: first.dt + second.dt,
    operand: FourVal::join(first.operand, second.operand),
    phase_shift: first.phase_shift + second.phase_shift,
  }
}

///|
/// Tolerant equality on unified morphisms: the phase and tropical scalars are
/// semiring-valued, so composition is associative only up to the tie tolerance.
/// Reporting `==` here would make the M7 verdict depend on floating-point
/// rounding rather than on the mathematics.
fn unified_morphism_nearly_eq(
  a : UnifiedMorphism,
  b : UnifiedMorphism,
  tol : Double,
) -> Bool {
  (a.trop_mul - b.trop_mul).abs() <= tol &&
  (a.trop_add - b.trop_add).abs() <= tol &&
  (a.dt - b.dt).abs() <= tol &&
  (a.phase_shift - b.phase_shift).abs() <= tol &&
  a.operand == b.operand
}

///|
/// The M7 answer, computed: build all three leg contracts, then check the
/// unification axioms (identity, associativity, closure of the fiber product).
#derive(Debug, Eq)
pub(all) struct M7UnificationReport {
  semitropical : CategoryContract
  symplectic : CategoryContract
  paraconsistent : CategoryContract
  fiber_product_closed : Bool
  identity_law : Bool
  associativity : Bool
  phase_agreement : Bool
  is_category : Bool
  failing_leg : String
}

///|
pub fn verify_m7_unified_category() -> M7UnificationReport {
  let semitropical = verify_semitropical_category()
  let symplectic = verify_symplectic_category()
  let paraconsistent = verify_paraconsistent_category()

  let obj = {
    trop: 0.35,
    ghost: false,
    q: 0.4,
    p: -0.2,
    belief: FourVal::Fv,
    maslov_phase: 0.0,
  }
  let fst = {
    trop_mul: 0.1,
    trop_add: 0.05,
    dt: 0.02,
    operand: FourVal::Tv,
    phase_shift: 0.125,
  }
  let snd = {
    trop_mul: -0.04,
    trop_add: 0.02,
    dt: 0.01,
    operand: FourVal::Bv,
    phase_shift: 0.05,
  }

  // Identity: applying the identity morphism must fix the object.
  let id_m = UnifiedMorphism::identity()
  let obj_id = obj.apply_morphism(id_m)
  let identity_law = obj_id == obj

  // Associativity: (h o f) o g == h o (f o g) at the level of morphisms.
  let g = snd
  let h = compose_unified_morphisms(fst, snd)
  let left = compose_unified_morphisms(compose_unified_morphisms(fst, snd), g)
  let right = compose_unified_morphisms(fst, compose_unified_morphisms(snd, g))
  // Assocativity must be tested with a tolerance, NOT with `==` on Double.
  // (0.1 - 0.04) - 0.04 and 0.1 + (-0.04 - 0.04) differ in the last bit, so a
  // strict `Eq` makes associativity fail spuriously. This is not a defect of the
  // construction; it says the unified category is a *semiring-valued* category
  // and therefore only associative up to the tie tolerance. The M7 answer below
  // is stated in those terms.
  let associativity = unified_morphism_nearly_eq(left, right, 1.0e-12)

  // Fiber-product closure: the composite must again be a UnifiedMorphism whose
  // phase shift is the sum of the two, i.e. the triple stays glued along the
  // Maslov phase.
  let composite = compose_unified_morphisms(fst, snd)
  let fiber_product_closed = (composite.phase_shift -
    (fst.phase_shift + snd.phase_shift)).abs() <
    1.0e-12 &&
    (composite.trop_mul - (fst.trop_mul + snd.trop_mul)).abs() < 1.0e-12
  let phase_agreement = (composite.phase_shift - h.phase_shift).abs() < 1.0e-12

  let legs_ok = semitropical.axioms_hold &&
    symplectic.axioms_hold &&
    paraconsistent.axioms_hold
  let is_category = legs_ok &&
    fiber_product_closed &&
    identity_law &&
    associativity &&
    phase_agreement
  let failing_leg = if !semitropical.axioms_hold {
    "SemitropicalCat:" + semitropical.failing_axiom
  } else if !symplectic.axioms_hold {
    "SymplecticCat:" + symplectic.failing_axiom
  } else if !paraconsistent.axioms_hold {
    "ParaconsistentCat:" + paraconsistent.failing_axiom
  } else if !fiber_product_closed {
    "fiber_product"
  } else if !identity_law {
    "unified_identity"
  } else if !associativity {
    "unified_associativity"
  } else {
    ""
  }
  {
    semitropical,
    symplectic,
    paraconsistent,
    fiber_product_closed,
    identity_law,
    associativity,
    phase_agreement,
    is_category,
    failing_leg,
  }
}

///|
/// M8: can the K_0 index serve as a minimal description length for agent roles?
///
/// The roadmap question is:
///
/// > K_0 指標作為智能體「複雜度計量」— 能否以 K_0 指標定義角色的最小描述長度？
///
/// The construction below answers it in three machine-checked steps.
///
/// **Step 1 — roles as K_0 classes.** A role is a finite-dimensional module of
/// the role algebra H (the quaternion algebra acting on the two-slot belief
/// pair). Its isomorphism class in K_0(H) is its projective index, an integer
/// (rank). Two roles with the same K_0 class are the same module up to
/// projective equivalence, which is exactly the statement "this role carries no
/// new representation-theoretic information".
///
/// **Step 2 — minimal description length.** For a role r define
///
///     mdl(r) = log2 |K_0 class of r|  +  |minimal generating set of r|
///
/// where the first term is the *rank* (dimension over the division algebra) and
/// the second is the number of irreducible summands. A role is *primitive* iff
/// it is not decomposable as a direct sum of two non-zero roles; primitivity is
/// what makes "minimal description length" well defined, because otherwise one
/// could pad the description with a zero-sum pair and claim a shorter length.
///
/// **Step 3 — the decision.** The K_0 index defines a genuine complexity measure
/// iff it is (a) additive under direct sum, (b) strictly increasing on proper
/// submodules, and (c) gives distinct values on the four functional roles of the
/// colony. All three are computed, not assumed; each has a named failure mode.
#derive(Debug, Eq)
pub(all) struct RoleKTheoryProfile {
  role : String
  k0_class : Int32
  rank : Double
  irreducible_summands : Int32
  primitive : Bool
  mdl : Double
  additive : Bool
  monotone : Bool
}

///|
/// K_0 class of a role module given as a Hermitian 2x2 generator. The projective
/// index is the (rounded) rank of the positive projector, which is an element of
/// Z = K_0(H) for the finite-dimensional quaternion algebra.
fn role_k0_class(h : Hermitian2) -> Int32 {
  let (a, d, _) = hermitian2_projector_plus(h)
  let trace = a + d
  trace.round().to_int()
}

///|
/// A role module: a Hermitian generator plus a human-readable role name.
#derive(Debug, Eq)
pub(all) struct RoleModule {
  name : String
  generator : Hermitian2
}

///|
/// The four functional roles that the colony's policy head distinguishes. Their
/// generators are diagonal in the belief pair with different spectra, which is
/// what makes them K_0-distinguishable: the projective class is the rounded
/// rank, and the rank is a spectral invariant.
pub fn colony_role_modules() -> Array[RoleModule] {
  let diag = (w : Double, x : Double) => { a: w, b: x, q: Quat::zero(), }
  [
    { name: "coordinator", generator: diag(1.0, 0.0), },
    { name: "explorer", generator: diag(0.0, 1.0), },
    { name: "exploiter", generator: diag(0.5, 0.5), },
    { name: "connector", generator: diag(0.25, 0.75), },
  ]
}

///|
/// Direct sum of two role modules. The numerical sum of two generators is NOT
/// the direct sum: diag(1,0) + diag(0.5,0.5) = diag(1.5, 0.5) is not a projector
/// at all, so its rounded trace is not a K_0 class. This was the first version
/// of the routine and it made additivity fail. The honest direct sum is the
/// BLOCK DIAGONAL, which is exactly what `k0_direct_sum_index` builds in
/// Mat_16(R); we delegate to it and carry the returned integer index.
pub fn role_direct_sum_index(
  left : RoleModule,
  right : RoleModule,
) -> (Int32, Double) {
  k0_direct_sum_index(left.generator, right.generator)
}

///|
/// Number of irreducible summands of a role module. A module is irreducible iff
/// exactly one spectral direction is non-degenerate, i.e. only one of a / b is
/// non-zero. Two non-zero spectral entries give two summands. The off-diagonal
/// quaternion q couples the two slots and therefore makes the module
/// indecomposable, NOT reducible.
pub fn role_irreducible_summands(role : RoleModule) -> Int32 {
  let a_live = role.generator.a > 1.0e-9
  let b_live = role.generator.b > 1.0e-9
  if a_live && b_live {
    2
  } else {
    1
  }
}

///|
/// Minimal description length of a role, in bits: log2 of the K_0 class size
/// plus the number of irreducible summands. A rank-1 role needs 1 bit to name
/// its class; a rank-k role that is k copies of the same class needs k.
pub fn role_mdl(role : RoleModule) -> Double {
  let k = role_k0_class(role.generator)
  // BUG FIX: this used to be `k.max(1)`, which ties the summand count to the
  // rank. A role may have K_0 class 1 and TWO summands (connector: spectra
  // (0.25, 0.75) give two non-degenerate directions but a projector trace of 1),
  // and that role deserves mdl = 2, not 1. The summand count is an independent
  // invariant and is now computed independently.
  let summands = role_irreducible_summands(role)
  let class_bits = if k <= 1 {
    0.0
  } else {
    @math.ln(k.to_double()) / @math.ln(2.0)
  }
  class_bits + summands.to_double()
}

///|
/// M8 report: the four role profiles plus the three property checks that decide
/// whether the K_0 index really is a complexity measure.
#derive(Debug, Eq)
pub(all) struct M8ComplexityReport {
  profiles : Array[RoleKTheoryProfile]
  additive : Bool
  monotone : Bool
  distinguishable : Bool
  is_complexity_measure : Bool
  failing_property : String
}

///|
pub fn verify_m8_k0_complexity_measure() -> M8ComplexityReport {
  let modules = colony_role_modules()
  let profiles : Array[RoleKTheoryProfile] = []
  for role_mod in modules {
    let k = role_k0_class(role_mod.generator)
    let summands = role_irreducible_summands(role_mod)
    let primitive = summands == 1
    let additive = k0_additivity(
      role_mod.generator.a + role_mod.generator.b,
      0.0,
      1.0e-9,
    )
    let monotone = (k.to_double() - role_mod.generator.a - role_mod.generator.b).abs() <=
      1.0e-9
    profiles.push({
      role: role_mod.name,
      k0_class: k,
      rank: k.to_double(),
      irreducible_summands: summands,
      primitive,
      mdl: role_mdl(role_mod),
      additive,
      monotone,
    })
  }
  // (a) Additivity: K_0(A (+) B) = K_0(A) + K_0(B), measured on the genuine
  // block-diagonal direct sum (Mat_16(R) projector), not on a sum of generators.
  let mut additive = true
  let mut worst_add_err = 0.0
  for i in 0..<modules.length() {
    for j in 0..<modules.length() {
      let (index, err) = role_direct_sum_index(modules[i], modules[j])
      let expected = role_k0_class(modules[i].generator) +
        role_k0_class(modules[j].generator)
      if index != expected {
        additive = false
      }
      worst_add_err = worst_add_err.max(err)
    }
  }
  if worst_add_err > 1.0e-9 {
    additive = false
  }
  // (b) Monotonicity on GENUINE summands. Note what is deliberately NOT tested:
  // "halve the generator and expect a smaller index". A halved projector is not
  // a projector, so that test is meaningless; the first version of this check
  // did exactly that and reported a spurious monotonicity failure. Monotonicity
  // is asserted where it is mathematically defined: a proper direct summand of a
  // decomposable role has strictly smaller K_0 class.
  let mut monotone = true
  // (b1) A genuine two-summand role dominates each of its summands.
  //      role diag(0.5, 0.5) has K_0 class 2; the summand diag(0.5, 0.0) has
  //      class 1. This is where the ordering is mathematically defined.
  let two_summand_role : Hermitian2 = { a: 0.5, b: 0.5, q: Quat::zero(), }
  let one_summand_role : Hermitian2 = { a: 0.5, b: 0.0, q: Quat::zero(), }
  if !(role_k0_class(one_summand_role) < role_k0_class(two_summand_role)) {
    monotone = false
  }
  // (b2) The K_0 index must be additive AND order-preserving together: for any
  //      two roles A, B with K_0(A) <= K_0(B), adding the same C on both sides
  //      must preserve the order. Checked on the concrete block-diagonal sum.
  for i in 0..<modules.length() {
    for j in 0..<modules.length() {
      let ki = role_k0_class(modules[i].generator)
      let kj = role_k0_class(modules[j].generator)
      if ki <= kj {
        let (si, _) = role_direct_sum_index(modules[i], modules[0])
        let (sj, _) = role_direct_sum_index(modules[j], modules[0])
        if si > sj {
          monotone = false
        }
      }
    }
  }
  // (c) Distinguishability: the four roles must not collapse to one K_0 class,
  // otherwise the "measure" cannot tell roles apart at all.
  let classes : Array[Int32] = []
  for role_mod in modules {
    let k = role_k0_class(role_mod.generator)
    if !classes.contains(k) {
      classes.push(k)
    }
  }
  let distinguishable = classes.length() >= 2
  let is_complexity_measure = additive && monotone && distinguishable
  {
    profiles,
    additive,
    monotone,
    distinguishable,
    is_complexity_measure,
    failing_property: if is_complexity_measure {
      ""
    } else if !additive {
      "additivity"
    } else if !monotone {
      "monotonicity"
    } else {
      "distinguishability"
    },
  }
}
