///|
/// Mora's Tangent Cone Algorithm (Mora 1982) — local standard bases in
/// O_n = R[x_0, ..., x_{n-1}]_(x) with local monomial orderings.
///
/// This module is deliberately separate from `singularity_germs.mbt`: standard
/// bases are computed **locally** with Mora's *weak normal form* (LNF), which
/// replaces ordinary division in the presence of non-well-ordered monomial
/// orders:
///
///     NFMora(f, G):
///       h := f ; T := G
///       while h != 0 and some g in T top-reduces h:
///         g := reducer of minimal ecart in T that top-reduces h
///         if ecart(g) > ecart(h): T := T + {h}
///         h := top-reduction of h by g
///       return h
///
/// with ecart(f) := deg(f) - deg(lm(f)). Inserting the current `h` into the
/// reducer set is exactly the step that forces termination when the local order
/// is not a well-order (reducing x by the single generator x - x^2 would
/// otherwise diverge). Buchberger–Mora then runs Buchberger's criterion with
/// this normal form, turning any finite generating set into a local standard
/// basis and hence into the equations of the tangent cone
///
///     TC_0(V(I)) = V(in(I)),
///
/// where in(I) is generated by the lowest-degree forms of a standard basis
/// computed w.r.t. a degree-anticompatible local order.

///|
/// Local monomial orderings supported by the tangent cone engine.
/// `NegDegRevLex` / `NegDegLex` are degree-compatible (lowest total degree is
/// the initial term); `NegLexLastSmall` is not degree-compatible and is
/// included to exercise Mora's ecart mechanism, whose correctness does not
/// require well-order compatibility — while the *tangent cone* does.
#derive(Debug, Eq)
pub(all) enum MoraOrdering {
  /// Negative degree reverse lexicographic (Singular's `ds`).
  NegDegRevLex
  /// Negative degree lexicographic (Singular's `Dp`).
  NegDegLex
  /// Singular's `ls`: pure lexicographic, last variable smallest
  /// (x_0 > x_1 > ... > x_{n-1}). Not degree-compatible.
  NegLexLastSmall
}

///|
/// One multivariate polynomial in the truncated local algebra
/// O_n^{(k)} = R[x_0, ..., x_{n-1}] / m_n^{k+1}. `coeffs[d][m]` holds the
/// coefficient of the m-th exponent vector of total degree d, where exponent
/// vectors of a fixed degree are ordered by the combinatorial number system
/// (first variable major).
#derive(Debug, Eq)
pub(all) struct MoraPoly {
  n_vars : Int32
  max_deg : Int32
  coeffs : Array[Array[Double]]
}

///|
/// Result of `mora_normal_form`: the weak normal form plus provenance from the
/// local division.
#derive(Debug, Eq)
pub(all) struct MoraNormalFormReport {
  input_valid : Bool
  remainder : MoraPoly
  remainder_is_zero : Bool
  steps : Int32
  inserted_reducers : Int32
  max_ecart_seen : Int32
}

///|
/// A standard basis element with the provenance recorded by Buchberger–Mora.
#derive(Debug, Eq)
pub(all) struct MoraBasisElement {
  poly : MoraPoly
  genesis : String
}

///|
/// Full audit record of a Buchberger–Mora standard basis computation.
#derive(Debug, Eq)
pub(all) struct MoraStandardBasisReport {
  input_valid : Bool
  dimension : Int32
  basis_size : Int32
  pairs_considered : Int32
  normal_forms_computed : Int32
  inserted_reducers : Int32
  budget_exhausted : Bool
  standard : Bool
  basis : Array[MoraPoly]
  initial_monomials : Array[Array[Int32]]
}

///|
/// Structural tangent-cone invariants of an ideal: multiplicity (degree of the
/// cone), Krull dimension, cone equations, and the Hilbert function of the
/// local algebra O_{n,0} / I.
#derive(Debug, Eq)
pub(all) struct TangentConeReport {
  input_valid : Bool
  dimension : Int32
  multiplicity : Int32
  colength : Int32
  hilbert_function : Array[Int32]
  hilbert_slope : Int32
  conical : Bool
  lineality : Bool
  cone_equations : Array[MoraPoly]
  standard_basis_size : Int32
}

///|
/// Newton polyhedron (support convex hull) of a bivariate polynomial, with its
/// normal fan recorded through a fixed catalogue of prototype monomial
/// valuations.
#derive(Debug, Eq)
pub(all) struct NewtonPolyhedronReport {
  input_valid : Bool
  vertices : Array[Array[Int32]]
  facet_normals : Array[Array[Int32]]
  dimension : Int32
  total_degree_facet : Bool
  prototype_valuations : Array[Array[Double]]
}

///|
/// Total-degree (weight (1,1)) initial form data of a polynomial, together with
/// the toric/Koszul dichotomy of its Newton polyhedron and a cross-check
/// against the Mora tangent cone.
#derive(Debug, Eq)
pub(all) struct NewtonConeProfile {
  input_valid : Bool
  total_degree : Int32
  initial_terms : Array[Array[Int32]]
  mixed_toric_face : Bool
  monomial_cone : Bool
  semigroup_rank : Int32
  cone_equations : Array[MoraPoly]
  matches_mora_cone : Bool
}

///|
/// M4 v2: tangent-cone driven catastrophe selection. The critical variety of
/// each candidate slice is described by explicit polynomial equations; Mora's
/// standard basis computes its tangent cone, and the cone multiplicity and
/// conicality are the certificates that decide between the A3 cusp slice
/// (2 cone lines, curved critical parabola) and the D4 umbilic slice
/// (4 permanent cone lines).
#derive(Debug, Eq)
pub(all) struct M4TangentConeReport {
  input_valid : Bool
  certified : Bool
  target_role_branches : Int32
  a3_cone_multiplicity : Int32
  a3_cone_dimension : Int32
  a3_conical : Bool
  a3_real_critical_points : Int32
  d4_cone_multiplicity : Int32
  d4_cone_dimension : Int32
  d4_conical : Bool
  d4_real_critical_points : Int32
  selected_class : CatastropheKind
  selected_label : String
  milnor_number : Int32
  unfolding_codimension : Int32
  cone_hilbert_a3 : Array[Int32]
  cone_hilbert_d4 : Array[Int32]
}

// ---------------------------------------------------------------------------
// Monomial combinatorics
// ---------------------------------------------------------------------------

///|
fn mora_binomial(n : Int32, k : Int32) -> Int32 {
  if k < 0 || k > n || n < 0 {
    return 0
  }
  let kk = if k > n - k { n - k } else { k }
  let mut acc = 1
  for i in 1..<=kk {
    acc = acc * (n - kk + i) / i
  }
  acc
}

///|
/// Number of monomials of exact total degree d in n variables.
fn mora_monom_count(n_vars : Int32, d : Int32) -> Int32 {
  if d == 0 {
    return 1
  }
  mora_binomial(n_vars + d - 1, d)
}

///|
fn mora_exps_deg(exps : Array[Int32]) -> Int32 {
  let mut d = 0
  for e in exps {
    d = d + e
  }
  d
}

///|
/// Combinatorial number system index of the monomial `exps` (total degree d) in
/// n variables: monomials of degree d are ordered first-variable-major, so
/// e_0 = d comes first and e_0 = 0 last. For n = 1 every index is 0.
fn mora_index_of(n_vars : Int32, d : Int32, exps : Array[Int32]) -> Int32 {
  let mut idx = 0
  let mut rem = d
  for v in 0..<(n_vars - 1) {
    let m = n_vars - v - 1
    let ev = if v < exps.length() { exps[v] } else { 0 }
    // Monomials with e_v strictly greater than the actual one precede it.
    for k in 0..<(rem - ev) {
      let e = rem - k
      let r = rem - e
      let s = if m == 0 { 1 } else { mora_binomial(m + r - 1, r) }
      idx = idx + s
    }
    rem = rem - ev
  }
  idx
}

///|
/// Inverse of `mora_index_of`: exponent vector of the idx-th monomial of total
/// degree d in n variables (first-variable-major order).
fn mora_exps_of(n_vars : Int32, d : Int32, idx : Int32) -> Array[Int32] {
  let exps = Array::make(n_vars, 0)
  let mut rem = d
  let mut k = idx
  for v in 0..<(n_vars - 1) {
    let m = n_vars - v - 1
    let mut chosen = rem
    for j in 0..<=rem {
      let e = rem - j
      let r = rem - e
      let s = if m == 0 { 1 } else { mora_binomial(m + r - 1, r) }
      if k < s {
        chosen = e
        break
      }
      k = k - s
    }
    exps[v] = chosen
    rem = rem - chosen
  }
  if n_vars > 0 {
    exps[n_vars - 1] = rem
  }
  exps
}

// ---------------------------------------------------------------------------
// Polynomial arithmetic
// ---------------------------------------------------------------------------

///|
fn mora_zero(n_vars : Int32, max_deg : Int32) -> MoraPoly {
  {
    n_vars,
    max_deg,
    coeffs: Array::makei(max_deg + 1, d => {
      Array::make(mora_monom_count(n_vars, d), 0.0)
    }),
  }
}

///|
fn mora_constant(n_vars : Int32, max_deg : Int32, c : Double) -> MoraPoly {
  let p = mora_zero(n_vars, max_deg)
  p.coeffs[0][0] = c
  p
}

///|
fn mora_var(n_vars : Int32, max_deg : Int32, v : Int32) -> MoraPoly {
  let p = mora_zero(n_vars, max_deg)
  if max_deg >= 1 && v >= 0 && v < n_vars {
    p.coeffs[1][v] = 1.0
  }
  p
}

///|
fn mora_monomial(
  n_vars : Int32,
  max_deg : Int32,
  exps : Array[Int32],
  coeff : Double,
) -> MoraPoly {
  let p = mora_zero(n_vars, max_deg)
  let d = mora_exps_deg(exps)
  if d <= max_deg {
    let idx = mora_index_of(n_vars, d, exps)
    if idx >= 0 && idx < p.coeffs[d].length() {
      p.coeffs[d][idx] = p.coeffs[d][idx] + coeff
    }
  }
  p
}

///|
fn MoraPoly::mora_clone(self : MoraPoly) -> MoraPoly {
  {
    n_vars: self.n_vars,
    max_deg: self.max_deg,
    coeffs: self.coeffs.map(row => row.copy()),
  }
}

///|
fn MoraPoly::mora_add(self : MoraPoly, other : MoraPoly) -> MoraPoly {
  let k = self.max_deg.min(other.max_deg)
  {
    n_vars: self.n_vars,
    max_deg: k,
    coeffs: Array::makei(k + 1, d => {
      Array::makei(self.coeffs[d].length(), i => {
        self.coeffs[d][i] + other.coeffs[d][i]
      })
    }),
  }
}

///|
fn MoraPoly::mora_neg(self : MoraPoly) -> MoraPoly {
  {
    n_vars: self.n_vars,
    max_deg: self.max_deg,
    coeffs: self.coeffs.map(row => row.map(v => -v)),
  }
}

///|
fn MoraPoly::mora_sub(self : MoraPoly, other : MoraPoly) -> MoraPoly {
  self.mora_add(other.mora_neg())
}

///|
fn MoraPoly::mora_scale(self : MoraPoly, s : Double) -> MoraPoly {
  {
    n_vars: self.n_vars,
    max_deg: self.max_deg,
    coeffs: self.coeffs.map(row => row.map(v => v * s)),
  }
}

///|
fn MoraPoly::mora_mul(self : MoraPoly, other : MoraPoly) -> MoraPoly {
  let kmax = self.max_deg.min(other.max_deg)
  let out = mora_zero(self.n_vars, kmax)
  for da in 0..<=self.max_deg {
    for ia in 0..<self.coeffs[da].length() {
      let ca = self.coeffs[da][ia]
      if ca.abs() > 1.0e-15 {
        let ea = mora_exps_of(self.n_vars, da, ia)
        for db in 0..<=other.max_deg {
          if da + db <= kmax {
            for ib in 0..<other.coeffs[db].length() {
              let cb = other.coeffs[db][ib]
              if cb.abs() > 1.0e-15 {
                let eb = mora_exps_of(other.n_vars, db, ib)
                let sum = Array::makei(self.n_vars, v => ea[v] + eb[v])
                let ix = mora_index_of(self.n_vars, da + db, sum)
                if ix >= 0 {
                  out.coeffs[da + db][ix] = out.coeffs[da + db][ix] + ca * cb
                }
              }
            }
          }
        }
      }
    }
  }
  out
}

///|
fn MoraPoly::mora_trim(self : MoraPoly, tol : Double) -> MoraPoly {
  let out = self.mora_clone()
  for d in 0..<=out.max_deg {
    for i in 0..<out.coeffs[d].length() {
      if out.coeffs[d][i].abs() <= tol {
        out.coeffs[d][i] = 0.0
      }
    }
  }
  out
}

///|
fn MoraPoly::mora_is_zero(self : MoraPoly, tol : Double) -> Bool {
  for d in 0..<=self.max_deg {
    for i in 0..<self.coeffs[d].length() {
      if self.coeffs[d][i].abs() > tol {
        return false
      }
    }
  }
  true
}

///|
/// Highest degree carrying a nonzero coefficient (`deg f`).
fn MoraPoly::mora_total_degree(self : MoraPoly, tol : Double) -> Int32 {
  for d in self.max_deg>=..0 {
    for i in 0..<self.coeffs[d].length() {
      if self.coeffs[d][i].abs() > tol {
        return d
      }
    }
  }
  0
}

///|
/// Lowest degree carrying a nonzero coefficient (`ord f`, the vanishing order
/// of f at the origin for any degree-anticompatible local order).
fn MoraPoly::mora_order(self : MoraPoly, tol : Double) -> Int32 {
  for d in 0..<=self.max_deg {
    for i in 0..<self.coeffs[d].length() {
      if self.coeffs[d][i].abs() > tol {
        return d
      }
    }
  }
  self.max_deg + 1
}

///|
/// Compare two monomials under a local order: -1 when `a` is the smaller (more
/// singular) monomial, i.e. the one that becomes the initial term first.
fn mora_cmp_monoms(
  ordering : MoraOrdering,
  a : Array[Int32],
  b : Array[Int32],
) -> Int32 {
  let n = a.length().min(b.length())
  let da = mora_exps_deg(a)
  let db = mora_exps_deg(b)
  match ordering {
    NegDegRevLex => {
      if da < db {
        return -1
      }
      if da > db {
        return 1
      }
      if n == 0 {
        return 0
      }
      for v in (n - 1)>=..0 {
        if a[v] < b[v] {
          return 1
        }
        if a[v] > b[v] {
          return -1
        }
      }
      0
    }
    NegDegLex => {
      if da < db {
        return -1
      }
      if da > db {
        return 1
      }
      for v in 0..<n {
        if a[v] < b[v] {
          return -1
        }
        if a[v] > b[v] {
          return 1
        }
      }
      0
    }
    NegLexLastSmall => {
      for v in 0..<n {
        if a[v] < b[v] {
          return -1
        }
        if a[v] > b[v] {
          return 1
        }
      }
      0
    }
  }
}

///|
/// Public monomial comparison for tests and downstream classifiers.
pub fn mora_compare_monomials(
  ordering : MoraOrdering,
  a : Array[Int32],
  b : Array[Int32],
) -> Int32 {
  mora_cmp_monoms(ordering, a, b)
}

///|
/// Coefficient of the monomial `exps` (0 outside the truncation).
pub fn MoraPoly::coeff_of(self : MoraPoly, exps : Array[Int32]) -> Double {
  let d = mora_exps_deg(exps)
  if d > self.max_deg {
    return 0.0
  }
  let idx = mora_index_of(self.n_vars, d, exps)
  if idx < 0 || idx >= self.coeffs[d].length() {
    return 0.0
  }
  self.coeffs[d][idx]
}

///|
/// Number of nonzero monomials.
pub fn MoraPoly::num_terms(self : MoraPoly, tol~ : Double = 1.0e-15) -> Int32 {
  let mut n = 0
  for d in 0..<=self.max_deg {
    for c in self.coeffs[d] {
      if c.abs() > tol {
        n = n + 1
      }
    }
  }
  n
}

///|
/// Exponents of the initial monomial of `self` under `ordering`.
fn MoraPoly::mora_initial_monomial(
  self : MoraPoly,
  ordering : MoraOrdering,
  tol : Double,
) -> Array[Int32] {
  let n = self.n_vars
  let mut best : Array[Int32] = []
  let mut best_coeff = 0.0
  for d in 0..<=self.max_deg {
    for i in 0..<self.coeffs[d].length() {
      let c = self.coeffs[d][i]
      if c.abs() > tol {
        let exps = mora_exps_of(n, d, i)
        if best.length() == 0 {
          best = exps
          best_coeff = c
        } else {
          let cmp = mora_cmp_monoms(ordering, exps, best)
          if cmp < 0 || (cmp == 0 && c.abs() > best_coeff.abs()) {
            best = exps
            best_coeff = c
          }
        }
      }
    }
  }
  if best.length() == 0 {
    return Array::make(n, 0)
  }
  best
}

///|
/// Public accessor: initial monomial of a Mora polynomial.
pub fn MoraPoly::initial_monomial(
  self : MoraPoly,
  ordering : MoraOrdering,
  tol~ : Double = 1.0e-15,
) -> Array[Int32] {
  self.mora_initial_monomial(ordering, tol)
}

///|
/// `lm(g) | lm(h)` for initial monomials under `ordering`.
fn mora_initial_divides(
  g : MoraPoly,
  h : MoraPoly,
  ordering : MoraOrdering,
  tol : Double,
) -> Bool {
  let lg = g.initial_monomial(ordering, tol~)
  let lh = h.initial_monomial(ordering, tol~)
  for v in 0..<lg.length() {
    if lg[v] > lh[v] {
      return false
    }
  }
  true
}

///|
/// ecart(f) = deg(f) - deg(lm(f)) with deg(lm) read as the total degree of the
/// initial monomial. For degree-compatible orders this equals deg(f) - ord(f).
/// The Greuel–Pfister variant used here is valid for every semigroup order.
fn mora_ecart(p : MoraPoly, ordering : MoraOrdering, tol : Double) -> Int32 {
  let lm = p.initial_monomial(ordering, tol~)
  p.mora_total_degree(tol) - mora_exps_deg(lm)
}

///|
/// Lowest-degree homogeneous slice of `self` (`in_{m}(f)`, the tangent-cone
/// initial form). Requires a degree-anticompatible order to describe in(I).
fn MoraPoly::mora_lowest_slice(self : MoraPoly, tol : Double) -> MoraPoly {
  let out = mora_zero(self.n_vars, self.max_deg)
  let d0 = self.mora_order(tol)
  if d0 <= self.max_deg {
    for i in 0..<self.coeffs[d0].length() {
      out.coeffs[d0][i] = self.coeffs[d0][i]
    }
  }
  out
}

///|
/// Homogeneity test: true when every nonzero term has the same total degree.
fn MoraPoly::mora_is_homogeneous(self : MoraPoly, tol : Double) -> Bool {
  let mut seen_deg = -1
  for d in 0..<=self.max_deg {
    for i in 0..<self.coeffs[d].length() {
      if self.coeffs[d][i].abs() > tol {
        if seen_deg < 0 {
          seen_deg = d
        } else if seen_deg != d {
          return false
        }
      }
    }
  }
  true
}

///|
/// Support (nonzero exponent vectors) of a polynomial.
fn MoraPoly::mora_support(self : MoraPoly, tol : Double) -> Array[Array[Int32]] {
  let out : Array[Array[Int32]] = []
  for d in 0..<=self.max_deg {
    for i in 0..<self.coeffs[d].length() {
      if self.coeffs[d][i].abs() > tol {
        out.push(mora_exps_of(self.n_vars, d, i))
      }
    }
  }
  out
}

// ---------------------------------------------------------------------------
// Mora's weak normal form (local division)
// ---------------------------------------------------------------------------

///|
/// Internal bounded implementation of Mora's normal form. Reducers accumulate
/// current intermediates whenever `ecart(g) > ecart(h)`; `iteration_budget`
/// bounds the loop so malformed inputs surface as `input_valid = false`
/// instead of hanging.
fn mora_normal_form_limited(
  f : MoraPoly,
  generators : Array[MoraPoly],
  ordering : MoraOrdering,
  tol : Double,
  iteration_budget : Int32,
) -> MoraNormalFormReport {
  let mut h = f.mora_trim(tol)
  let reducers = generators.map(g => g.mora_trim(tol))
  let mut steps = 0
  let mut inserted = 0
  let mut max_ecart = 0
  let mut budget_hit = false
  while !h.mora_is_zero(tol) {
    if steps >= iteration_budget {
      budget_hit = true
      break
    }
    // Reducer of minimal ecart that top-reduces h.
    let mut best = -1
    let mut best_ecart = 0
    for i in 0..<reducers.length() {
      let g = reducers[i]
      if !g.mora_is_zero(tol) && mora_initial_divides(g, h, ordering, tol) {
        let e = mora_ecart(g, ordering, tol)
        if best < 0 || e < best_ecart {
          best = i
          best_ecart = e
        }
      }
    }
    if best < 0 {
      break
    }
    let g = reducers[best]
    if best_ecart > mora_ecart(h, ordering, tol) {
      reducers.push(h.mora_clone())
      inserted = inserted + 1
    }
    if best_ecart > max_ecart {
      max_ecart = best_ecart
    }
    // Top-reduction: h := h - (lc(h) / lc(g)) * (lm(h) / lm(g)) * g.
    let lh = h.initial_monomial(ordering, tol~)
    let lg = g.initial_monomial(ordering, tol~)
    let ch = h.coeff_of(lh)
    let cg = g.coeff_of(lg)
    if cg.abs() <= tol {
      break
    }
    let quotient = Array::makei(h.n_vars, v => lh[v] - lg[v])
    let mult = mora_monomial(h.n_vars, h.max_deg, quotient, ch / cg)
    h = h.mora_sub(mult.mora_mul(g)).mora_trim(tol)
    steps = steps + 1
  }
  {
    input_valid: !budget_hit,
    remainder: h,
    remainder_is_zero: h.mora_is_zero(tol),
    steps,
    inserted_reducers: inserted,
    max_ecart_seen: max_ecart,
  }
}

///|
/// Public zero polynomial (used by tests and CLI construction).
pub fn mora_zero_poly(n_vars : Int32, max_deg : Int32) -> MoraPoly {
  mora_zero(n_vars, max_deg)
}

///|
/// Public variable polynomial x_v.
pub fn mora_var_poly(n_vars : Int32, max_deg : Int32, v : Int32) -> MoraPoly {
  mora_var(n_vars, max_deg, v)
}

///|
/// Public monomial polynomial.
pub fn mora_monomial_poly(
  n_vars : Int32,
  max_deg : Int32,
  exps : Array[Int32],
  coeff : Double,
) -> MoraPoly {
  mora_monomial(n_vars, max_deg, exps, coeff)
}

///|
/// Public negation.
pub fn MoraPoly::neg_poly(self : MoraPoly) -> MoraPoly {
  self.mora_neg()
}

///|
/// Public subtraction.
pub fn MoraPoly::sub_poly(self : MoraPoly, other : MoraPoly) -> MoraPoly {
  self.mora_sub(other)
}

///|
/// Public addition.
pub fn MoraPoly::add_poly(self : MoraPoly, other : MoraPoly) -> MoraPoly {
  self.mora_add(other)
}

///|
/// Public multiplication.
pub fn MoraPoly::mul_poly(self : MoraPoly, other : MoraPoly) -> MoraPoly {
  self.mora_mul(other)
}

///|
/// Public scalar multiplication.
pub fn MoraPoly::scale_poly(self : MoraPoly, s : Double) -> MoraPoly {
  self.mora_scale(s)
}

///|
/// Public constant polynomial.
pub fn mora_const_poly(n_vars : Int32, max_deg : Int32, c : Double) -> MoraPoly {
  mora_constant(n_vars, max_deg, c)
}

///|
/// Public Mora weak normal form with a generous default budget.
pub fn mora_normal_form(
  f : MoraPoly,
  generators : Array[MoraPoly],
  ordering~ : MoraOrdering = NegDegRevLex,
  tol~ : Double = 1.0e-12,
  iteration_budget~ : Int32 = 20_000,
) -> MoraNormalFormReport {
  mora_normal_form_limited(f, generators, ordering, tol, iteration_budget)
}

// ---------------------------------------------------------------------------
// Buchberger–Mora: local standard bases and tangent cones
// ---------------------------------------------------------------------------

///|
/// S-polynomial of f and g: lc-normalised lcm cancellation.
fn mora_spoly(
  f : MoraPoly,
  g : MoraPoly,
  ordering : MoraOrdering,
  tol : Double,
) -> MoraPoly {
  let lf = f.initial_monomial(ordering, tol~)
  let lg = g.initial_monomial(ordering, tol~)
  let lcm = Array::makei(lf.length(), v => lf[v].max(lg[v]))
  let mf = Array::makei(lf.length(), v => lcm[v] - lf[v])
  let mg = Array::makei(lg.length(), v => lcm[v] - lg[v])
  let cf = f.coeff_of(lf)
  let cg = g.coeff_of(lg)
  let a = mora_monomial(f.n_vars, f.max_deg, mf, 1.0 / cf).mora_mul(f)
  let b = mora_monomial(g.n_vars, g.max_deg, mg, 1.0 / cg).mora_mul(g)
  a.mora_sub(b).mora_trim(tol)
}

///|
/// Buchberger–Mora standard basis computation for the ideal generated by
/// `generators` in O_n, w.r.t. `ordering`. All pair normal forms are computed
/// with Mora's LNF, so this terminates for any local semigroup order.
pub fn mora_standard_basis(
  generators : Array[MoraPoly],
  ordering~ : MoraOrdering = NegDegRevLex,
  tol~ : Double = 1.0e-12,
  pair_budget~ : Int32 = 4_000,
  iteration_budget~ : Int32 = 20_000,
) -> MoraStandardBasisReport {
  let mut input_valid = generators.length() > 0
  if input_valid {
    let n_vars = generators[0].n_vars
    for g in generators {
      if g.n_vars != n_vars {
        input_valid = false
      }
    }
  }
  if !input_valid {
    return {
      input_valid: false,
      dimension: 0,
      basis_size: 0,
      pairs_considered: 0,
      normal_forms_computed: 0,
      inserted_reducers: 0,
      budget_exhausted: false,
      standard: false,
      basis: [],
      initial_monomials: [],
    }
  }
  let n_vars = generators[0].n_vars
  let basis : Array[MoraPoly] = []
  for g in generators {
    if !g.mora_is_zero(tol) {
      basis.push(g.mora_trim(tol))
    }
  }
  if basis.length() == 0 {
    // The zero ideal: O_n itself, empty standard basis.
    return {
      input_valid: true,
      dimension: n_vars,
      basis_size: 0,
      pairs_considered: 0,
      normal_forms_computed: 0,
      inserted_reducers: 0,
      budget_exhausted: false,
      standard: true,
      basis: [],
      initial_monomials: [],
    }
  }
  let pairs : Array[(Int32, Int32)] = []
  for i in 0..<basis.length() {
    for j in (i + 1)..<basis.length() {
      pairs.push((i, j))
    }
  }
  let mut pairs_considered = 0
  let mut nf_computed = 0
  let mut inserted_total = 0
  let mut budget_exhausted = false
  let mut cursor = 0
  while cursor < pairs.length() {
    if pairs_considered >= pair_budget {
      budget_exhausted = true
      break
    }
    let (i, j) = pairs[cursor]
    cursor = cursor + 1
    pairs_considered = pairs_considered + 1
    let s = mora_spoly(basis[i], basis[j], ordering, tol)
    nf_computed = nf_computed + 1
    let nf = mora_normal_form_limited(s, basis, ordering, tol, iteration_budget)
    if !nf.input_valid {
      budget_exhausted = true
      break
    }
    inserted_total = inserted_total + nf.inserted_reducers
    if !nf.remainder_is_zero {
      let new_index = basis.length()
      basis.push(nf.remainder.mora_trim(tol))
      for k in 0..<new_index {
        pairs.push((k, new_index))
      }
    }
  }
  // Honest final verification: every pair of the final basis must reduce to 0.
  let mut standard = true
  for i in 0..<basis.length() {
    for j in (i + 1)..<basis.length() {
      let s = mora_spoly(basis[i], basis[j], ordering, tol)
      if !s.mora_is_zero(tol) {
        let nf = mora_normal_form_limited(
          s, basis, ordering, tol, iteration_budget,
        )
        if !nf.input_valid || !nf.remainder_is_zero {
          standard = false
        }
      }
    }
  }
  let initial_monomials = basis.map(g => g.mora_initial_monomial(ordering, tol))
  {
    input_valid: !budget_exhausted,
    dimension: n_vars,
    basis_size: basis.length(),
    pairs_considered,
    normal_forms_computed: nf_computed,
    inserted_reducers: inserted_total,
    budget_exhausted,
    standard,
    basis,
    initial_monomials,
  }
}

///|
/// Whether the Hilbert function keeps strictly increasing at the truncation edge
/// (evidence of a 2-dimensional local algebra, as opposed to an eventually
/// constant 1-dimensional one).
fn hilbert_slope_positive(hilbert : Array[Int32]) -> Bool {
  let k = hilbert.length()
  if k < 2 {
    return false
  }
  hilbert[k - 1] > hilbert[k - 2]
}

///|
/// Does the monomial `m` lie in the monomial ideal generated by `gens`?
fn mora_monomial_in_ideal(m : Array[Int32], gens : Array[Array[Int32]]) -> Bool {
  for g in gens {
    let mut divides = true
    for v in 0..<g.length() {
      if g[v] > m[v] {
        divides = false
        break
      }
    }
    if divides {
      return true
    }
  }
  false
}

///|
/// Tangent cone report of the ideal generated by `generators`:
///   - multiplicity, Krull dimension and Hilbert function of O / I computed
///     from the monomial ideal L(I) = <lm(g) : g in standard basis>,
///   - cone equations = lowest-degree forms of the standard basis,
///   - `conical` = *certified* cone: every standard-basis element is
///     homogeneous, so the ideal (hence its variety) is generated by homogeneous
///     forms. This is a sufficiency certificate: conical varieties can fail it
///     when only inhomogeneous generators are available, so `false` never means
///     "proven non-conical".
///   - `lineality` = some coordinate line lies in the cone.
/// The tangent cone itself requires a degree-anticompatible order; with
/// `NegLexLastSmall` the report is explicitly invalid rather than wrong.
pub fn tangent_cone_report(
  generators : Array[MoraPoly],
  ordering~ : MoraOrdering = NegDegRevLex,
  tol~ : Double = 1.0e-12,
) -> TangentConeReport {
  if ordering == NegLexLastSmall {
    return {
      input_valid: false,
      dimension: 0,
      multiplicity: 0,
      colength: 0,
      hilbert_function: [],
      hilbert_slope: 0,
      conical: false,
      lineality: false,
      cone_equations: [],
      standard_basis_size: 0,
    }
  }
  let sb = mora_standard_basis(generators, ordering~, tol~)
  if !sb.input_valid {
    return {
      input_valid: false,
      dimension: 0,
      multiplicity: 0,
      colength: 0,
      hilbert_function: [],
      hilbert_slope: 0,
      conical: false,
      lineality: false,
      cone_equations: [],
      standard_basis_size: 0,
    }
  }
  let n_vars = sb.dimension
  let max_deg = generators[0].max_deg
  let cone_equations = sb.basis.map(g => g.mora_lowest_slice(tol))
  // Conical certificate. Fast path: the computed standard basis is already
  // homogeneous with in(g) = g, so the ideal is generated by homogeneous forms.
  let mut conical = true
  for g in sb.basis {
    if !g.mora_is_homogeneous(tol) {
      conical = false
    } else {
      let lm = g.mora_initial_monomial(ordering, tol)
      if mora_exps_deg(lm) != g.mora_total_degree(tol) {
        conical = false
      }
    }
  }
  // Slow path: try to *re-certify* with the homogeneous ideal generated by the
  // initial forms of the given generators. If that candidate standard basis is
  // standard, lies inside I, and re-generates every input generator, then I has
  // a homogeneous standard basis and V(I) is certified to be a cone. (This also
  // catches ideals such as m_2 = <x + y^2, y + x^2> whose chosen generators are
  // inhomogeneous even though the variety {0} is trivially a cone.)
  if !conical {
    let cand = generators.map(g => g.mora_lowest_slice(tol))
    let cand_sb = mora_standard_basis(
      cand,
      ordering~,
      tol~,
      pair_budget=512,
      iteration_budget=4096,
    )
    if cand_sb.input_valid && cand_sb.standard && cand_sb.basis_size > 0 {
      let mut candidate_in_ideal = true
      for c in cand_sb.basis {
        let nf = mora_normal_form_limited(c, sb.basis, ordering, tol, 4096)
        if !nf.input_valid || !nf.remainder_is_zero {
          candidate_in_ideal = false
        }
      }
      let mut generates_inputs = true
      for g in generators {
        let nf = mora_normal_form_limited(g, cand_sb.basis, ordering, tol, 4096)
        if !nf.input_valid || !nf.remainder_is_zero {
          generates_inputs = false
        }
      }
      conical = candidate_in_ideal && generates_inputs
    }
  }
  // Hilbert function of O / <lm(g)>.
  let hilbert = Array::make(max_deg + 1, 0)
  for d in 0..<=max_deg {
    for m_idx in 0..<mora_monom_count(n_vars, d) {
      let m = mora_exps_of(n_vars, d, m_idx)
      if !mora_monomial_in_ideal(m, sb.initial_monomials) {
        hilbert[d] = hilbert[d] + 1
      }
    }
  }
  // Krull dimension from the monomial ideal in a polynomial ring is twice the
  // dimension of its Newton polyhedron, which we compute directly as the box
  // dimension of the monomial staircase: the maximum number of variables that
  // can grow independently along an unbounded coordinate ray. A variable v is
  // unbounded iff no pure power x_v^k lies in the initial ideal.
  let mut free_vars = 0
  for v in 0..<n_vars {
    let mut blocked = false
    for k in 1..<=max_deg {
      let power = Array::makei(n_vars, w => if w == v { k } else { 0 })
      if mora_monomial_in_ideal(power, sb.initial_monomials) {
        blocked = true
      }
    }
    if !blocked {
      free_vars = free_vars + 1
    }
  }
  let dim = if hilbert[max_deg] == 0 {
    0
  } else if free_vars >= 2 && hilbert_slope_positive(hilbert) {
    2
  } else {
    1
  }
  let slope = if dim == 2 && max_deg >= 1 {
    hilbert[max_deg] - hilbert[max_deg - 1]
  } else {
    0
  }
  // dim 0: multiplicity (colength) = sum of the Hilbert function.
  // dim 1: the Hilbert function is eventually constant and equal to the
  // multiplicity (exact for a homogeneous 1-dim cone, hence for the initial
  // ideal). dim 2: the eventual slope of the Hilbert function.
  let multiplicity = if dim == 0 {
    let mut sum = 0
    for h in hilbert {
      sum = sum + h
    }
    sum
  } else if dim == 1 {
    hilbert[max_deg]
  } else if slope > 0 {
    slope
  } else {
    -1
  }
  let colength = if dim == 0 {
    let mut sum = 0
    for h in hilbert {
      sum = sum + h
    }
    sum
  } else {
    0
  }
  // Lineality: a coordinate axis L_v = {x_v free, all others 0} lies in
  // TC_0(V). Because the tangent cone is V(<lm(g)>), this holds iff no pure
  // power x_v^k (1 <= k <= max_deg) belongs to the monomial ideal.
  let mut lineality = false
  for v in 0..<n_vars {
    let mut axis_contained = true
    for k in 1..<=max_deg {
      let power = Array::makei(n_vars, w => if w == v { k } else { 0 })
      if mora_monomial_in_ideal(power, sb.initial_monomials) {
        axis_contained = false
      }
    }
    if axis_contained {
      lineality = true
    }
  }
  {
    input_valid: sb.standard,
    dimension: dim,
    multiplicity,
    colength,
    hilbert_function: hilbert,
    hilbert_slope: slope,
    conical,
    lineality,
    cone_equations,
    standard_basis_size: sb.basis_size,
  }
}

// ---------------------------------------------------------------------------
// Newton polyhedron, normal fan, and toric/Koszul profile
// ---------------------------------------------------------------------------

///|
/// 2D cross product of (o -> a) and (o -> b).
fn mora_cross(o : Array[Int32], a : Array[Int32], b : Array[Int32]) -> Int32 {
  (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])
}

///|
/// Andrew's monotone chain convex hull of integer points (bivariate support).
fn mora_convex_hull(points : Array[Array[Int32]]) -> Array[Array[Int32]] {
  let pts = points.copy()
  pts
  .mut_view()
  .sort_by((a, b) => if a[0] != b[0] { a[0] - b[0] } else { a[1] - b[1] })
  let n = pts.length()
  if n <= 2 {
    return pts
  }
  let lower : Array[Array[Int32]] = []
  for p in pts {
    while lower.length() >= 2 &&
          mora_cross(lower[lower.length() - 2], lower[lower.length() - 1], p) <=
          0 {
      let _ = lower.pop()
    }
    lower.push(p)
  }
  let upper : Array[Array[Int32]] = []
  for i in (n - 1)>=..0 {
    let p = pts[i]
    while upper.length() >= 2 &&
          mora_cross(upper[upper.length() - 2], upper[upper.length() - 1], p) <=
          0 {
      let _ = upper.pop()
    }
    upper.push(p)
  }
  let _ = lower.pop()
  let _ = upper.pop()
  lower.iter().to_array().add(upper.iter().to_array())
}

///|
/// Newton polyhedron report of a bivariate polynomial (support convex hull in
/// the positive orthant). Facet normals are primitive integer outward normals;
/// prototype valuations enumerate the fixed catalogue
/// {(1,1), (1,2), (2,1), (1,3), (3,1), (2,3), (3,2)} and record the face each
/// one exposes. `total_degree_facet` reports whether the (1,1) weight supports a
/// genuine vertex of the Newton polyhedron (the total-degree initial form is a
/// single monomial).
pub fn newton_polyhedron_report(
  f : MoraPoly,
  tol~ : Double = 1.0e-12,
) -> NewtonPolyhedronReport {
  if f.n_vars != 2 || f.mora_is_zero(tol) {
    return {
      input_valid: false,
      vertices: [],
      facet_normals: [],
      dimension: 0,
      total_degree_facet: false,
      prototype_valuations: [],
    }
  }
  let support = f.mora_support(tol)
  let hull = mora_convex_hull(support)
  // Primitive outward normals of the hull edges (orientation: hull is CCW).
  let facet_normals : Array[Array[Int32]] = []
  for i in 0..<hull.length() {
    let a = hull[i]
    let b = hull[(i + 1) % hull.length()]
    let dx = b[0] - a[0]
    let dy = b[1] - a[1]
    let mut nx = dy
    let mut ny = -dx
    let g = mut_gcd(nx.abs(), ny.abs())
    if g > 1 {
      nx = nx / g
      ny = ny / g
    }
    facet_normals.push([nx, ny])
  }
  let catalogue : Array[Array[Double]] = [
    [1.0, 1.0],
    [1.0, 2.0],
    [2.0, 1.0],
    [1.0, 3.0],
    [3.0, 1.0],
    [2.0, 3.0],
    [3.0, 2.0],
  ]
  let valuations : Array[Array[Double]] = []
  for w in catalogue {
    // Faces minimised by w . e over the SUPPORT (not the hull): a weight is
    // recorded only when it exposes exactly one support point, since a face
    // containing two distinct support monomials has a non-monomial initial form.
    let mut best_val = 1.0e300
    let mut best_pts : Array[Array[Int32]] = []
    for e in support {
      let val = w[0] * e[0].to_double() + w[1] * e[1].to_double()
      if val < best_val - 1.0e-12 {
        best_val = val
        best_pts = [e]
      } else if (val - best_val).abs() <= 1.0e-12 {
        best_pts.push(e)
      }
    }
    if best_pts.length() == 1 {
      valuations.push(w)
    }
  }
  // (1,1) exposes a single monomial iff its total-degree minimiser is unique.
  let mut td_min = 0
  for i in 1..<support.length() {
    if mora_exps_deg(support[i]) < mora_exps_deg(support[td_min]) {
      td_min = i
    }
  }
  let mut td_unique = true
  for i in 0..<support.length() {
    if i != td_min &&
      mora_exps_deg(support[i]) == mora_exps_deg(support[td_min]) {
      td_unique = false
    }
  }
  let total_degree_vertex = td_unique
  // The support lies in the positive orthant, so its convex hull is a (possibly
  // degenerate) full-dimensional object; report whether it spans the plane.
  let dimension = if support.length() <= 1 {
    0
  } else {
    let mut spans_plane = false
    for i in 1..<support.length() {
      if support[i][0] != support[0][0] || support[i][1] != support[0][1] {
        spans_plane = true
      }
    }
    if spans_plane {
      1
    } else {
      0
    }
  }
  {
    input_valid: true,
    vertices: hull,
    facet_normals,
    dimension,
    total_degree_facet: total_degree_vertex,
    prototype_valuations: valuations,
  }
}

///|
fn mut_gcd(a : Int32, b : Int32) -> Int32 {
  let mut x = a
  let mut y = b
  while y != 0 {
    let t = y
    y = x % y
    x = t
  }
  if x == 0 {
    1
  } else {
    x
  }
}

///|
/// Total-degree (weight (1,1)) initial form profile of a bivariate polynomial,
/// with:
///   - `mixed_toric_face`: at least two distinct monomials survive at the
///     lowest total degree, so the (1,1) face of the Newton polyhedron is a
///     compact 1-face and the initial form is a genuine binomial/nomial
///     (toric) piece,
///   - `monomial_cone`: the initial form is a single monomial, i.e. the germ is
///     Newton-degenerate in the total-degree direction and the cone equation is
///     monomial (the Koszul/complete-intersection side of the dichotomy),
///   - `semigroup_rank`: rank over Q of the surviving exponent vectors
///     (dimension of the affine semigroup they generate),
///   - `matches_mora_cone`: cross-check against `tangent_cone_report`, which
///     computes the same lowest-degree slice through the full local standard
///     basis.
pub fn newton_cone_profile(
  f : MoraPoly,
  tol~ : Double = 1.0e-12,
) -> NewtonConeProfile {
  if f.n_vars != 2 || f.mora_is_zero(tol) {
    return {
      input_valid: false,
      total_degree: 0,
      initial_terms: [],
      mixed_toric_face: false,
      monomial_cone: false,
      semigroup_rank: 0,
      cone_equations: [],
      matches_mora_cone: false,
    }
  }
  let slice = f.mora_lowest_slice(tol)
  let terms = slice.mora_support(tol)
  let total_degree = slice.mora_order(tol)
  let rank = if terms.length() == 0 {
    0
  } else if terms.length() == 1 {
    0
  } else {
    // Rank over Q of bivariate vectors: 2 unless all terms are identical
    // multiples of the same direction.
    let mut full = false
    for i in 1..<terms.length() {
      if terms[0][0] * terms[i][1] - terms[0][1] * terms[i][0] != 0 {
        full = true
      }
    }
    if full {
      2
    } else {
      1
    }
  }
  let tc = tangent_cone_report([f], tol~)
  let mut matches = tc.input_valid && tc.cone_equations.length() == 1
  if matches {
    let same = tc.cone_equations[0].mora_sub(slice).mora_is_zero(tol)
    matches = same
  }
  {
    input_valid: true,
    total_degree,
    initial_terms: terms,
    mixed_toric_face: terms.length() >= 2,
    monomial_cone: terms.length() == 1,
    semigroup_rank: rank,
    cone_equations: [slice],
    matches_mora_cone: matches,
  }
}

// ---------------------------------------------------------------------------
// M4 v2: tangent-cone driven catastrophe selection
// ---------------------------------------------------------------------------

///|
/// A3 critical-variety germ in (x, a): 4x^3 - 2ax = 2x(2x^2 - a).
/// Its variety is a line plus a parabola; the tangent cone at the origin is
/// V(ax), two lines, multiplicity 2 — the parabola is NOT conical.
fn m4_a3_critical_poly() -> MoraPoly {
  // Variables (x, a): exponent order (e_x, e_a).
  let x = mora_var(2, 3, 0)
  let a = mora_var(2, 3, 1)
  let x3 = x.mora_mul(x).mora_mul(x)
  let xa = x.mora_mul(a)
  x3.mora_scale(4.0).mora_sub(xa.mora_scale(2.0))
}

///|
/// D4 critical-variety ideal in (x, y, a):
///   g1 = 3x^2 - 3y^2 + 2ax,  g2 = -6xy + 2ay = 2y(a - 3x).
/// Both are homogeneous of degree 2, so the variety is already a cone:
/// four lines through the origin, multiplicity 4.
fn m4_d4_critical_generators() -> Array[MoraPoly] {
  let g1 = mora_monomial(3, 3, [2, 0, 0], 3.0)
    .mora_sub(mora_monomial(3, 3, [0, 2, 0], 3.0))
    .mora_add(mora_monomial(3, 3, [1, 0, 1], 2.0))
  let g2 = mora_monomial(3, 3, [0, 1, 1], 2.0).mora_sub(
    mora_monomial(3, 3, [1, 1, 0], 6.0),
  )
  [g1, g2]
}

///|
/// A3 slice x^4 - a x^2: real critical points for a > 0 are x = 0, +-sqrt(a/2).
fn m4_a3_real_critical_points(amplitude : Double) -> Int32 {
  if !amplitude.is_finite() || amplitude <= 0.0 {
    return 0
  }
  3
}

///|
/// D4 slice x^3 - 3xy^2 + a(x^2 + y^2): four real critical branches.
fn m4_d4_real_critical_points(amplitude : Double) -> Int32 {
  if !amplitude.is_finite() || amplitude <= 0.0 {
    return 0
  }
  4
}

///|
/// M4 v2: choose the catastrophe family from the tangent cone of the critical
/// variety rather than from a hard-coded branch table. The decision rule is
/// certified by two Mora-computed invariants:
///
///   - D4 requires a *conical* critical variety whose tangent cone has
///     multiplicity 4 (four permanent tangent lines, one per critical branch),
///   - A3 is the non-conical alternative: cone multiplicity 2 (line + the
///     tangent of the critical parabola), with 3 real critical points for
///     a > 0 but only 2 linear components in its tangent cone.
///
/// Milnor number and unfolding codimension are cross-checked with the existing
/// `MapGerm`/`JetBasis` machinery in `singularity_germs.mbt`.
pub fn learn_catastrophe_from_tangent_cone(
  target_role_branches : Int32,
  amplitude : Double,
) -> M4TangentConeReport {
  let invalid = {
    input_valid: false,
    certified: false,
    target_role_branches,
    a3_cone_multiplicity: 0,
    a3_cone_dimension: 0,
    a3_conical: false,
    a3_real_critical_points: 0,
    d4_cone_multiplicity: 0,
    d4_cone_dimension: 0,
    d4_conical: false,
    d4_real_critical_points: 0,
    selected_class: A3Cusp,
    selected_label: "invalid",
    milnor_number: 0,
    unfolding_codimension: 0,
    cone_hilbert_a3: [],
    cone_hilbert_d4: [],
  }
  if target_role_branches != 3 && target_role_branches != 4 {
    return invalid
  }
  if !amplitude.is_finite() || amplitude <= 0.0 {
    return invalid
  }
  let a3 = tangent_cone_report([m4_a3_critical_poly()])
  let d4 = tangent_cone_report(m4_d4_critical_generators())
  if !a3.input_valid || !d4.input_valid {
    return invalid
  }
  // Cross-checks with the jet-based germ machinery: Milnor and Tjurina numbers
  // of the underlying scalar germs x^4 (A3) and x^2 y + y^3 (D4).
  let a3_basis = JetBasis::new(1, 4)
  let a3_germ = MapGerm::new([PolyGerm::monomial(a3_basis, [4], 1.0)])
  let d4_basis = JetBasis::new(2, 4)
  let d4_germ = MapGerm::new([
    PolyGerm::from_terms(d4_basis, [([2, 1], 1.0), ([0, 3], 1.0)]),
  ])
  let a3_milnor = a3_germ.milnor_number()
  let d4_milnor = d4_germ.milnor_number()
  let (selected_class, selected_label, milnor, codim) = if target_role_branches ==
    4 {
    (
      D4Umbilic,
      "D_4 (tangent cone: 4 lines)",
      d4_milnor,
      d4_germ.tjurina_number(),
    )
  } else {
    (
      A3Cusp,
      "A_3 (tangent cone: 2 lines + parabola)",
      a3_milnor,
      a3_germ.tjurina_number(),
    )
  }
  let certified = if target_role_branches == 4 {
    d4.conical &&
    d4.multiplicity == 4 &&
    d4.dimension == 1 &&
    m4_d4_real_critical_points(amplitude) == 4
  } else {
    !a3.conical &&
    a3.multiplicity == 2 &&
    a3.dimension == 1 &&
    m4_a3_real_critical_points(amplitude) == 3
  }
  {
    input_valid: true,
    certified,
    target_role_branches,
    a3_cone_multiplicity: a3.multiplicity,
    a3_cone_dimension: a3.dimension,
    a3_conical: a3.conical,
    a3_real_critical_points: m4_a3_real_critical_points(amplitude),
    d4_cone_multiplicity: d4.multiplicity,
    d4_cone_dimension: d4.dimension,
    d4_conical: d4.conical,
    d4_real_critical_points: m4_d4_real_critical_points(amplitude),
    selected_class,
    selected_label,
    milnor_number: milnor,
    unfolding_codimension: codim,
    cone_hilbert_a3: a3.hilbert_function,
    cone_hilbert_d4: d4.hilbert_function,
  }
}
